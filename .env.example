# Build-time variables (NEXT_PUBLIC_* are baked into the browser bundle).
# Prod values live in GitHub → Settings → Secrets and variables → Actions → Variables,
# the workflow passes them as build-args, the Dockerfile as ARG/ENV. Leave empty to disable.

NEXT_PUBLIC_APP_URL=https://app.yool.live

# Yandex Metrika counter number and GA4 measurement id. Empty → no counter scripts in the HTML.
NEXT_PUBLIC_YM_ID=
NEXT_PUBLIC_GA4_ID=

# Search console meta-tag verification codes (only if DNS verification is not used).
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
NEXT_PUBLIC_YANDEX_VERIFICATION=

# Server-only: where /api/leads forwards the form. Defaults to the prod API.
# API_BASE_URL=http://127.0.0.1:3999/api/v1
